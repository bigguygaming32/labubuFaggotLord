local function ExpandNumber(Value)
    if type(Value) == "number" then
        return Value
    end

    if type(Value) ~= "string" then
        return Value
    end

    Value = Value:gsub("%s+", "")

    local Number, Suffix = Value:match("^([+-]?%d*%.?%d+)(.*)$")

    if not Number then
        return Value
    end

    local Multiplier = Suffixes[Suffix]

    if Multiplier == nil then
        return Value
    end

    return tonumber(Number) * 10 ^ Multiplier
end

